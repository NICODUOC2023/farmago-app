{
  "expo": {
    "name": "Farmago",
    "slug": "farmago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farmago",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.farmago.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Farmago usa tu ubicación para mostrar las farmacias cercanas con stock.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDEBFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.farmago.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Farmago accede a tus fotos para permitirte escanear recetas.",
          "cameraPermission": "Farmago usa la cámara para escanear recetas médicas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEBFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "process.env.ANDROID_MAPS_API_KEY",
          "iosGoogleMapsApiKey": "process.env.IOS_MAPS_API_KEY"
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7dcd31bb-2f05-4a25-baa7-e9e03dcea6e8"
      }
    },
    "owner": "nicodev32"
  }
}
