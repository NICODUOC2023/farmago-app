# Proveedor de mapa: 'google' (react-native-maps: Google en Android, Apple
# Maps en iOS) o 'mapbox' (@rnmapbox/maps con tu estilo pastel de Studio).
EXPO_PUBLIC_MAP_PROVIDER=

# --- Mapbox (solo si EXPO_PUBLIC_MAP_PROVIDER=mapbox o quieres el estilo custom)
# Copia este archivo a `.env` y reemplaza con tu Access Token público de Mapbox
# (https://account.mapbox.com/access-tokens/). Sin token, la app usa un mapa
# placeholder pastel para que puedas seguir validando el diseño.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Style URL de tu estilo custom en Mapbox Studio (plantilla "Light" ajustada).
# Ej: mapbox://styles/tu-usuario/clxyzabc
EXPO_PUBLIC_MAPBOX_STYLE_URL=

# --- Google Maps (react-native-maps)
# API key de Google Cloud (Maps SDK for Android) con restricción al paquete y
# SHA-1 de tu app. Se inyecta en el AndroidManifest en tiempo de build.
ANDROID_MAPS_API_KEY=

# Opcional: solo si decides usar PROVIDER_GOOGLE también en iOS. Por defecto
# iOS usa Apple Maps y no necesita key.
IOS_MAPS_API_KEY=

# --- Gemini (escaneo de recetas)
# ⚠️ EXPO_PUBLIC_* se empaqueta en el bundle del cliente: esta key queda
# EXPUESTA en el APK/IPA. Sirve solo para desarrollo. En la siguiente fase el
# llamado a Gemini debe moverse a una Supabase Edge Function y esta variable
# debe ELIMINARSE del cliente.
EXPO_PUBLIC_GEMINI_API_KEY=

# Modelo de Gemini para el OCR de recetas (dejar el default si no sabés).
EXPO_PUBLIC_GEMINI_MODEL=

# --- Supabase
# URL del proyecto (Dashboard > Project Settings > Data API > Project URL).
EXPO_PUBLIC_SUPABASE_URL=

# Clave pública anon (Dashboard > Project Settings > API Keys > anon/public).
# Es segura de exponer SIEMPRE que RLS esté habilitado en todas las tablas.
# NUNCA poner aquí la service_role key ni claves secretas.
EXPO_PUBLIC_SUPABASE_ANON_KEY=